# Supabase — get these from your project at https://supabase.com/dashboard/project/<your-project>/settings/api
# Vite requires the VITE_ prefix (not NEXT_PUBLIC_ used by Next.js).
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
